{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relink-example",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "relink-example",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "triggers": { "crons": ["* * * * *"] },
}
